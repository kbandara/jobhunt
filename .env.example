# Copy this file to .env and fill it in. NEVER commit .env — it is gitignored,
# and it is also the one file that survives every `git pull` untouched, so this
# is the right place for anything you want to keep across updates.
#
#   Copy-Item .env.example .env
#   notepad .env
#
# Save as "UTF-8", not "UTF-8 with BOM". (If you get it wrong the app now says
# so on startup rather than silently ignoring the first line.)

# Which provider to use: gemini | anthropic
# Gemini has a free tier — get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini

# Paste your key after the "=", with no quotes. Only the one for your chosen
# provider matters; leave the other blank.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Model overrides (optional)
#
# Model names go out of date when providers retire them. Set them here rather
# than editing server/llm/registry.js — that file is code and gets updated, so
# editing it causes merge conflicts on `git pull`. Nothing in .env ever
# conflicts.
#
# Run `npm run models` to see which names your key can actually reach.
#
#   MODEL_GEMINI=gemini-3.6-flash              all Gemini tasks
#   MODEL_GEMINI_GENERATE_CV=gemini-3.6-pro    one task only (wins over above)
#   MODEL_ANTHROPIC_GENERATE_CV=claude-sonnet-5
#
# Task names: PARSE_JD, SCORE_BATCH, SCORE_DEEP, GENERATE_CV,
#             GENERATE_COVER_LETTER, GENERATE_CRITERIA
# ---------------------------------------------------------------------------

# Output ceiling per step. Raise this if a step fails as "truncated": on Gemini
# the model's own reasoning is charged against the same budget as the answer, so
# a long document can run out of room mid-sentence. Same naming as MODEL_*.
#
#   MAX_TOKENS_GEMINI_GENERATE_CV=65536
#   MAX_TOKENS_GEMINI=32768
#
# How long to wait for a model to answer, in milliseconds, before giving up.
#
# Each step already has its own deadline in server/llm/registry.js, chosen for
# what it does: reading a job ad gives up after two minutes, writing or
# rewriting a whole CV gets seven. Leave this commented out and those apply.
#
# Setting it overrides EVERY step with the one number — which is the blunt fix
# when something keeps timing out and you would rather wait than tune:
# LLM_TIMEOUT_MS=600000
#
# To give one step longer without touching the rest:
# TIMEOUT_MS_GEMINI_REVISE_DOC=900000

# Local server port
PORT=4477
